// This is your Prisma schema file matching the exact ERD journey

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuthUser {
  id             String                @id @default(uuid())
  email          String                @unique
  name           String
  avatarUrl      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  memberships    OrganizationMember[]

  @@map("auth_users")
}

model Organization {
  id                 String                @id @default(uuid())
  name               String
  slug               String                @unique
  creditBalance      Float                 @default(30.0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  members            OrganizationMember[]
  businessProfiles   BusinessProfile[]
  icpProfiles        IcpProfile[]
  companies          Company[]
  campaigns          Campaign[]
  replies            Reply[]
  creditTransactions CreditTransaction[]
  subscriptions      Subscription[]
  integrations       Integration[]

  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(uuid())
  organizationId String
  userId         String
  role           String        @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt       DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AuthUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model BusinessProfile {
  id               String        @id @default(uuid())
  organizationId   String
  websiteUrl       String
  companyName      String
  summary          String
  valueProposition String
  offerHook        String
  primaryIndustry  String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model IcpProfile {
  id                 String        @id @default(uuid())
  organizationId     String
  name               String
  targetIndustries   String        // JSON array stringified
  headcountRanges    String        // JSON array stringified
  targetLocations    String        // JSON array stringified
  buyerPersonas      String        // JSON array stringified
  exclusionKeywords  String        // JSON array stringified
  isDefault          Boolean       @default(false)
  createdAt          DateTime      @default(now())

  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns          Campaign[]

  @@map("icp_profiles")
}

model Company {
  id               String        @id @default(uuid())
  organizationId   String
  name             String
  domain           String
  industry         String
  category         String
  headcount        String
  employeesCount   Int
  revenueRange     String
  city             String
  state            String?
  country          String
  techStack        String        // JSON array stringified
  description      String
  googleMapsRating Float?
  googleMapsReviews Int?
  createdAt        DateTime      @default(now())

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts         Contact[]

  @@map("companies")
}

model Contact {
  id               String         @id @default(uuid())
  companyId        String
  name             String
  title            String
  email            String
  isVerified       Boolean        @default(false)
  linkedinUrl      String?
  phone            String?
  createdAt        DateTime       @default(now())

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignLeads    CampaignLead[]

  @@map("contacts")
}

model Campaign {
  id                  String          @id @default(uuid())
  organizationId      String
  icpProfileId        String?
  name                String
  status              String          @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  dailySendLimit      Int             @default(50)
  sendStartTime       String          @default("09:00")
  sendEndTime         String          @default("17:30")
  timezoneMatching    Boolean         @default(true)
  createdAt           DateTime        @default(now())

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icpProfile          IcpProfile?     @relation(fields: [icpProfileId], references: [id])
  emailSequences      EmailSequence[]
  campaignLeads       CampaignLead[]

  @@map("campaigns")
}

model EmailSequence {
  id              String        @id @default(uuid())
  campaignId      String
  stepNumber      Int           // 1, 2, 3
  stepType        String        // INITIAL_HOOK, VALUE_ADD, BREAKUP
  delayDays       Int           @default(0)
  subjectTemplate String
  bodyTemplate    String
  createdAt       DateTime      @default(now())

  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("email_sequences")
}

model CampaignLead {
  id                String         @id @default(uuid())
  campaignId        String
  contactId         String
  status            String         @default("QUEUED") // QUEUED, IN_PROGRESS, OPENED, REPLIED, BOOKED, BOUNCED
  currentStepNumber Int            @default(1)
  customVariables   String?        // JSON stringified
  lastSentAt        DateTime?
  nextStepDueAt     DateTime?
  assignedAt        DateTime       @default(now())

  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  emailMessages     EmailMessage[]
  replies           Reply[]

  @@unique([campaignId, contactId])
  @@map("campaign_leads")
}

model EmailMessage {
  id                 String        @id @default(uuid())
  campaignLeadId     String
  sequenceStepNumber Int
  mailboxSender      String
  recipientEmail     String
  subject            String
  body               String
  status             String        @default("QUEUED") // QUEUED, SENT, DELIVERED, OPENED, BOUNCED, FAILED
  sentAt             DateTime?
  openedAt           DateTime?
  openCount          Int           @default(0)
  createdAt          DateTime      @default(now())

  campaignLead       CampaignLead  @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)

  @@map("email_messages")
}

model Reply {
  id                  String        @id @default(uuid())
  organizationId      String
  campaignLeadId      String?
  fromEmail           String
  fromName            String
  subject             String
  body                String
  intent              String        // MEETING_REQUEST, INTERESTED, OBJECTION, NOT_INTERESTED, OUT_OF_OFFICE
  confidenceScore     Float
  suggestedAction     String
  suggestedDraftReply String
  isAddressed         Boolean       @default(false)
  receivedAt          DateTime      @default(now())

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignLead        CampaignLead? @relation(fields: [campaignLeadId], references: [id])

  @@map("replies")
}

model CreditTransaction {
  id             String        @id @default(uuid())
  organizationId String
  type           String        // WELCOME_GRANT, EMAIL_DISPATCH_DEDUCTION, CREDIT_PURCHASE, DATA_EXPORT
  amountCredits  Int
  costUsd        Float
  description    String
  balanceAfter   Float
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

model Subscription {
  id               String        @id @default(uuid())
  organizationId   String
  planName         String        // Free Trial, Pay-As-You-Go, Enterprise Data
  status           String        @default("ACTIVE")
  monthlyBasePrice Float         @default(0)
  emailUnitCost    Float         @default(0.033)
  creditAllowance  Int           @default(1000)
  currentPeriodEnd DateTime

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Integration {
  id             String        @id @default(uuid())
  organizationId String
  type           String        // CAL_COM, CALENDLY, MCP_API, SMARTLEAD, APOLLO, SLACK_WEBHOOK
  name           String
  status         String        @default("CONNECTED")
  config         String        // JSON configuration
  lastSyncedAt   DateTime?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("integrations")
}
